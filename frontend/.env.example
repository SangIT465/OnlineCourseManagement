# Public API base URL. In development /api is forwarded by Vite.
VITE_API_BASE_URL=/api

# Used by the Vite server only; never included in the browser bundle.
API_PROXY_TARGET=http://localhost:5106

# For a frontend deployed separately, use its actual backend URL at build time:
# VITE_API_BASE_URL=https://api.example.com/api
# Add the frontend origin to the backend Cors:AllowedOrigins configuration.
