{
  "info": {
    "name": "CourseFlow API - local demonstration",
    "description": "Run in order against a development database. Creates and removes only POSTMAN QA records. Enter Admin credentials privately in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({key:'X-Request-ID', value:'postman-' + pm.variables.replaceIn('{{$guid}}')});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.environment.set('adminToken', pm.response.json().token); pm.environment.set('accessToken', pm.response.json().token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Current account",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Public paginated catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/courses/paged?PageNumber=1&PageSize=5&SortBy=price&IsDescending=false",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Validation error for invalid price range",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/courses/paged?MinPrice=500&MaxPrice=100",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Unauthenticated directory access is denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Create QA category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"POSTMAN QA {{$guid}}\",\n  \"description\": \"Temporary API demonstration\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.environment.set('categoryId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Read QA category",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Update QA category",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categories/{{categoryId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"POSTMAN QA updated {{$guid}}\",\n  \"description\": \"Updated through the API\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Create QA course",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/courses",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"POSTMAN QA course {{$timestamp}}\",\n  \"description\": \"CourseFlow API demonstration\",\n  \"price\": 0,\n  \"categoryId\": {{categoryId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.environment.set('courseId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Read QA course",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/courses/{{courseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Update QA course",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/courses/{{courseId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"POSTMAN QA updated course\",\n  \"description\": \"Updated through the API\",\n  \"price\": 199000,\n  \"categoryId\": {{categoryId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Create QA lesson",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/lessons",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"POSTMAN QA lesson\",\n  \"content\": \"Learning content\",\n  \"durationMinutes\": 20,\n  \"orderIndex\": 1,\n  \"courseId\": {{courseId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.environment.set('lessonId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Read private lesson as Admin",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/lessons/{{lessonId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Update QA lesson",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/lessons/{{lessonId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"POSTMAN QA lesson updated\",\n  \"content\": \"Updated learning content\",\n  \"durationMinutes\": 25,\n  \"orderIndex\": 1,\n  \"courseId\": {{courseId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Cannot delete a course containing lessons",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/courses/{{courseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Register temporary student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"POSTMAN QA Student\",\n  \"email\": \"{{qaStudentEmail}}\",\n  \"password\": \"{{qaStudentPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('qaStudentEmail', 'postman-qa-' + pm.variables.replaceIn('{{$guid}}') + '@example.test');",
              "pm.environment.set('qaStudentPassword', pm.variables.replaceIn('{{$guid}}') + 'A1!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.environment.set('studentId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Student login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{qaStudentEmail}}\",\n  \"password\": \"{{qaStudentPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('studentToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Enroll as temporary student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/enrollments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseId\": {{courseId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Complete the lesson",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/progress/lessons/{{lessonId}}/complete",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Verify stored learning progress",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/progress/courses/{{courseId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Lesson progress is persisted', () => pm.expect(pm.response.json().percentage).to.eql(100));"
            ]
          }
        }
      ]
    },
    {
      "name": "21 Student cannot change course content",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/courses/{{courseId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Forbidden change\",\n  \"price\": 0,\n  \"categoryId\": {{categoryId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Remove QA lesson and its progress",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/lessons/{{lessonId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Verify progress remains consistent",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/progress/courses/{{courseId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Removed lesson no longer counts', () => pm.expect(pm.response.json().totalLessons).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "24 Cancel temporary enrollment",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/enrollments/{{courseId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{studentToken}}",
