{
  "name": "courseflow",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "dotnet run --project backend/OnlineCourseManagement.Api --launch-profile http",
    "build": "node scripts/build.mjs",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "dotnet build OnlineCourseManagement.sln",
    "test": "node scripts/test.mjs",
    "test:authorization": "node backend/tests/authorization.integration.mjs",
    "test:crud": "node backend/tests/crud.integration.mjs",
    "seed:catalog": "dotnet run --project backend/OnlineCourseManagement.Api --configuration Release --launch-profile http -- --seed-catalog --Logging:LogLevel:Microsoft.EntityFrameworkCore=Warning",
    "test:backend": "dotnet test backend/OnlineCourseManagement.Api.Tests --configuration Release",
    "test:contracts": "node backend/tests/backend-contract.integration.mjs",
    "publish:backend": "dotnet publish backend/OnlineCourseManagement.Api --configuration Release --output artifacts/backend"
  }
}
