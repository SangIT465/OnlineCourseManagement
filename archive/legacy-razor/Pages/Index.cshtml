@page
@model IndexModel
@{
    ViewData["Title"] = "Không gian học tập";
}
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<div class="app-shell">
    <button class="sidebar-scrim" aria-label="Đóng menu" data-action="close-menu" hidden></button>
    <aside class="sidebar" id="sidebar" aria-label="Điều hướng chính">
        <a class="brand" href="#/dashboard" aria-label="CourseFlow - Trang chủ">
            <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="m5 9 11-5 11 5-11 5Z"/><path d="m5 16 11 5 11-5M5 23l11 5 11-5"/></svg></span>
            <span>course<span class="brand-light">flow</span><small>HỌC TẬP MỖI NGÀY</small></span>
        </a>
        <div class="workspace-label">KHÔNG GIAN CỦA BẠN</div>
        <nav id="primary-nav"></nav>
        <div class="sidebar-bottom">
            <div class="sidebar-note"><span class="note-spark" aria-hidden="true">✳</span><h3>Mỗi ngày, tiến xa hơn.</h3><p>Một bài học nhỏ hôm nay.<br />Một bước tiến lớn ngày mai.</p><a href="#/courses">Tìm khóa học phù hợp</a></div>
            <button class="sidebar-help" data-action="help"><span data-icon="help"></span>Trợ giúp &amp; hướng dẫn</button>
            <div id="sidebar-account"></div>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar">
            <div class="topbar-location"><button class="icon-button mobile-menu" data-action="toggle-menu" aria-label="Mở menu" aria-expanded="false"><span data-icon="menu"></span></button><span class="breadcrumb-root">Không gian học tập</span><span class="breadcrumb-separator">/</span><strong id="breadcrumb">Tổng quan</strong></div>
            <div class="topbar-actions"><form id="global-search" role="search"><span data-icon="search"></span><input name="search" type="search" placeholder="Tìm khóa học…" aria-label="Tìm kiếm khóa học" maxlength="200" /><kbd>/</kbd></form><button class="icon-button" data-action="refresh" title="Làm mới dữ liệu" aria-label="Làm mới dữ liệu"><span data-icon="refresh"></span></button><div class="topbar-divider"></div><div id="topbar-account"></div></div>
        </header>
        <main id="main-content" tabindex="-1" aria-busy="true"><div class="initial-loading"><span class="spinner"></span>Đang chuẩn bị không gian của bạn…</div></main>
        <footer class="app-footer"><span>© @DateTime.Now.Year CourseFlow. Học tập không giới hạn.</span><span>Được xây dựng cho hành trình của bạn <span class="footer-dot"></span></span></footer>
    </div>
</div>
<dialog id="app-dialog" aria-labelledby="dialog-title"></dialog>
<div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="false"></div>
<noscript><div class="noscript-message">Vui lòng bật JavaScript để sử dụng giao diện CourseFlow.</div></noscript>
@section Scripts {
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
}
